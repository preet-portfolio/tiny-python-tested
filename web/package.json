{
  "name": "tiny-python-tested-web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "bundle": "cd ../python && $([ -x ../.venv/bin/python ] && echo ../.venv/bin/python || echo python3) -m tptl.stage --web ../web/public",
    "dev": "next dev -p 3210",
    "build": "next build",
    "start": "npx serve out -l 3210",
    "pyodide": "node scripts/fetch-pyodide.mjs",
    "prebuild": "npm run bundle && node scripts/fetch-pyodide.mjs",
    "postbuild": "node scripts/check-moments.mjs",
    "predev": "node scripts/fetch-pyodide.mjs"
  },
  "dependencies": {
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "codemirror": "6.0.2",
    "next": "16.4.6",
    "pyodide": "314.0.7",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
